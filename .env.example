# Leave all three unset to run in zero-key "demo mode" — the API falls back
# to keyword retrieval over the same knowledge base (lib/knowledgeBase.js)
# so the widget still works without any external API calls.
#
# Priority if multiple are set: GROQ_API_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY

# Free option: Groq (no credit card, generous free tier, fast Llama models)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (Claude) — paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI — paid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
